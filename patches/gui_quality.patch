     # Fragmentos                                                          #
     # ------------------------------------------------------------------ #
 
+    def _fragment_quality_lookup(self) -> dict[str, dict]:
+        """Mapa texto_fragmento -> {ok, audio_s} desde la caché del perfil del proyecto."""
+        project = self.current_project
+        if not project:
+            return {}
+        info = getattr(self, "_projects", {}).get(project) or {}
+        voice = info.get("voice_profile")
+        if not voice:
+            return {}
+        try:
+            profile = self.store.get_profile(voice)
+            if profile is None:
+                return {}
+            rows = self.store.conn.execute(
+                "SELECT text, ok, audio_s FROM fragments WHERE profile_id = ?",
+                (int(profile["id"]),),
+            ).fetchall()
+        except Exception:
+            return {}
+        out: dict[str, dict] = {}
+        for row in rows:
+            # el último registro gana si hay colisiones de texto
+            out[str(row["text"])] = {
+                "ok": bool(row["ok"]),
+                "audio_s": float(row["audio_s"] or 0.0),
+            }
+        return out
+
+    def _on_quality_retry_toggled(self, checked: bool) -> None:
+        self.settings.quality_retry = bool(checked)
+        self._persist_settings()
+        state = "activado" if checked else "desactivado"
+        self._toast(f"Reintento automático de anomalías {state}.")
+
+    def _persist_settings(self) -> None:
+        """Guarda self.settings en data/config.json (sin campos efímeros)."""
+        from dataclasses import asdict, fields
+        cfg = self.data_dir / "config.json"
+        try:
+            data = asdict(self.settings)
+            # last_activity_time es runtime; no ensuciar el JSON
+            data.pop("last_activity_time", None)
+            known = {f.name for f in fields(self.settings)}
+            data = {k: v for k, v in data.items() if k in known and k != "last_activity_time"}
+            cfg.write_text(__import__("json").dumps(data, indent=2), encoding="utf-8")
+        except Exception as exc:
+            self._toast(f"No se pudo guardar config: {exc}")
+
     def action_load_fragments(self) -> None:
         self._load_fragments(quiet=False)
 
